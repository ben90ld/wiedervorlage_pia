{
  "name": "wiedervorlage",
  "version": "0.2.1",
  "private": true,
  "description": "Wiedervorlage – lokale, offlinefähige Aufgaben-Wiedervorlage (PIA)",
  "scripts": {
    "build": "node tools/build.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test": "npm run build && npm run test:unit && npm run test:e2e"
  }
}
